h3.title = l @title

- if @is_bulk_editing
  h3 = l :label_bulk_edit_selected_issues
  ul
    - @issues.each do |issue|
      li = link_to_issue issue
- else
  h3
    span = link_to_issue @issues.first

= form_tag issue_tags_path(ids: @issue_ids, search: params[:search], mode: @mode) do
  fieldset.box
    legend = l :field_tags
    #issue_tags
      - if @mode == 'remove'
        / Only the tags of the chosen issues can be removed, so no search for others
        = additionals_select2_tag 'issue[tag_list]',
                                  options_for_select(@issue_tags.map { |tag| [tag, tag] }),
                                  multiple: true,
                                  placeholder: l(:label_remove_tags)
      - else
        = additionals_select2_tag 'issue[tag_list]',
                                  options_for_select(@mode == 'append' ? {} : @issue_tags.map { |tag| [tag, tag] }, @issue_tags),
                                  multiple: true,
                                  url: issue_tags_auto_completes_path(project_id: @project),
                                  placeholder: @is_bulk_editing ? t(:label_no_change_option) : '+ add tag',
                                  tags: User.current.allowed_to?(:create_issue_tags, @project)
        p.most-used-tags
          = safe_join @most_used_tags.collect { |t| tag.span t.name, class: 'most-used-tag' }, ', '

  .buttons
    = submit_tag l(@submit_label), name: nil
    '
    = link_to_function l(:button_cancel), 'hideModal(this)'

javascript:
  var mostUsedTags = #{raw @most_used_tags.map(&:name).to_json};
